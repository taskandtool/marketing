# Never commit credentials or local state. Task & Tool delivers env to a
# machine at install time; nothing in this repo should ever hold a key.
.env
.env.*
!.env.example
.envrc
*.pem
*.key

# Working material and output are the owner's, made on their own machine.
# The folders and the notes that explain them ship with the app; nobody's
# brand, research, creatives, emails or reports do.
/brand/*
/public/*
creatives/*
emails/*
reports/*
research/*
media/clips/*
media/photos/*
raw/*
lists/*
uploads/*
!**/.gitkeep
!**/README.md
!**/_index.md

# Tool noise
/dist/
# Quartz runs npm install in the linked plugin folder on each new machine.
/viewer/*/package-lock.json
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
